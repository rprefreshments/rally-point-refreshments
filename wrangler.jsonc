{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rally-point-refreshments",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-03",
  "workers_dev": false,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*",
      "/admin.html",
      "/pay",
      "/pay/*",
      "/pay.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "vars": {
    "ORDER_EMAIL": "rprefreshment@gmail.com",
    "EMAIL_FROM": "Rally Point Orders <orders@rallypointrefreshments.com>",
    "PUBLIC_SITE_URL": "https://rallypointrefreshments.com"
  }
}
